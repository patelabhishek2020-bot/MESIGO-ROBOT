# Mesigo AI — infrastructure only (owner config lives in Setup Wizard)
# Copy to .env on the VPS. Do NOT put LLM/Twilio/banking secrets here.

POSTGRES_USER=mesigo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mesigo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Bootstrap secrets for first boot (rotate after Setup Wizard)
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=change-me-fernet-key-generate-with-python

# Public URLs (Hostinger VPS)
API_CORS_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default owner bootstrap (changed in Setup Wizard)
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=ChangeMeImmediately!

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
